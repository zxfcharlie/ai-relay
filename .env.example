# Host-side port the service is published on (container always listens on 8511 internally)
HOST_PORT=8511

# Only needed if this server can't reach api.openai.com / api.anthropic.com
# directly (common if they're blocked from your network) — point this at an
# HTTP(S) proxy you have access to. Leave blank/commented out otherwise.
# HTTPS_PROXY=http://your-proxy-host:port
